{
  "name": "pi-mcp-extension",
  "version": "1.9.10",
  "description": "MCP (Model Context Protocol) client extension for the Pi coding agent — connect Pi to any MCP server",
  "type": "module",
  "keywords": [
    "pi-package",
    "mcp",
    "model-context-protocol",
    "pi",
    "pi-extension",
    "ai-agent",
    "tool-bridge"
  ],
  "author": "irahardianto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irahardianto/pi-mcp-extension.git"
  },
  "homepage": "https://github.com/irahardianto/pi-mcp-extension",
  "bugs": {
    "url": "https://github.com/irahardianto/pi-mcp-extension/issues"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test ./tests/*.test.ts",
    "test:coverage": "node --import tsx/esm --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=83 ./tests/*.test.ts",
    "test:integration": "node --import tsx/esm --test ./tests/server-manager.test.ts"
  }
}
