// Example MCP server configuration for pi-mcp-extension
// Copy this to ~/.pi/agent/mcp.json (global) or .pi/mcp.json (project)
// and customize with your actual servers and credentials.
//
// IMPORTANT: Never commit your actual mcp.json with secrets/API keys.
// The .pi/ directory should be in your .gitignore.
{
  "settings": {
    "toolPrefix": "mcp",
    "requestTimeoutMs": 30000,
    "maxRetries": 5
  },
  "mcpServers": {
    // ── HTTP servers with OAuth 2.1 (streamable-http) ──────────────────────
    // Use "transport": "streamable-http" (or omit "transport" when "url" is set;
    // "transport": "http" and "type": "http" are also accepted) with "auth"
    // (or "oauth") for remote servers that use OAuth 2.1 (PKCE + DCR):

    "supabase": {
      "transport": "streamable-http",
      "url": "https://mcp.supabase.com/mcp",
      "auth": {
        "type": "oauth"
      },
      "lifecycle": "eager"
    },

    "deepsource": {
      "url": "https://mcp.deepsource.com/mcp",
      "auth": {
        "type": "oauth"
      },
      "lifecycle": "eager"
    },

    // ── HTTP servers with static API key / Bearer headers ──────────────────
    // Note: when "auth" is set on a server, OAuth owns the Authorization header
    // and any static "Authorization" entry in "headers" is ignored.

    "zai-web-search": {
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_ZAI_API_KEY"
      },
      "lifecycle": "lazy"
    },

    // ── Legacy SSE servers ─────────────────────────────────────────────────
    "legacy-sse-server": {
      "transport": "sse",
      "url": "https://example.com/mcp/sse",
      "lifecycle": "lazy"
    },

    // ── stdio subprocess servers ───────────────────────────────────────────
    // Use "transport": "stdio" (or omit, since it's the default) along with
    // "command" and optionally "args", "cwd", and "env" for subprocess servers.

    "pathfinder": {
      "transport": "stdio",
      "command": "pathfinder-mcp",
      "args": ["/path/to/your/project"],
      "lifecycle": "eager"
    },

    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp"],
      // Optional per-server working directory (stdio only). A relative path resolves
      // against the session working directory; "~" expands to your home directory.
      "cwd": "./",
      "env": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY"
      },
      "lifecycle": "lazy"
    },

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"],
      "lifecycle": "lazy"
    }

    // ── Project-level partial overrides (.pi/mcp.json only) ────────────────
    // In a trusted project's .pi/mcp.json, an entry with no "command", "url",
    // "type", or "transport" overrides only per-project settings ("enabled" or
    // "lifecycle") while keeping the global server's URL, command, and credentials:
    //
    // "supabase": {
    //   "enabled": false
    // }
  }
}
